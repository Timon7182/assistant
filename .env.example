# скопируйте в .env и заполните
API_KEY=change-me                 # ключ для API и websocket (X-API-Key / ?key=)
DASH_USER=admin
DASH_PASSWORD=change-me           # вход в дашборд (Basic auth)
CLAUDE_CODE_OAUTH_TOKEN=          # claude setup-token -> сюда; тогда LLM = Claude через claude cli
CLAUDE_MODEL=sonnet               # sonnet (быстрее) | opus
# LLM_PROVIDER=openai             # принудительно: openai | claude-cli | anthropic
# LLM_URL=http://192.168.88.49:8050/v1
# LLM_MODEL=current-LLM
WHISPER_MODEL=small               # tiny | base | small | medium
MEM_LIMIT=4g
CPU_LIMIT=4
OMP_THREADS=4
PORT=8060
